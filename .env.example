# Backend-only Supabase connection. Keep the real value in .env (which is ignored).
# Get the URI from Supabase Dashboard → Connect. Never use an anon/service key here.
VULNASS_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Local SQLite fallback database (used when VULNASS_DATABASE_URL is unset).
# VULNASS_DATABASE_PATH=data/vulnassess.db

# Copy this to .env and add provider keys locally. Never commit real keys.
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Optional NVD rate-limit credential. Use a fresh key; never paste it into reports.
# NVD works without a key. Only the official NVD HTTPS API receives this header.
NVD_API_KEY=
# Independent optional providers. Keep their real keys in ignored .env.groq2 / .env.google.
# .env.groq2: GROQ_SECONDARY_API_KEY=...
# .env.google: GEMINI_API_KEY=...

# Reasoning provider (advisory analyst layer; never exposed to the browser).
# DEEPSEEK_API_KEY=sk-YOUR-DEEPSEEK-KEY
# VULNASS_REASONING_PROVIDER=ollama   # ollama | deepseek
